# Copy this file to  .env  at the REPO ROOT (not inside server/) and fill it in.
# .env is already gitignored — never commit real values.

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# Atlas → Database → Connect → Drivers → Node.js
# Insert the database name before the "?" and URL-encode special characters in
# the password:  @ → %40   # → %23   / → %2F   : → %3A
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hybrid_encryption?retryWrites=true&w=majority

# ─── Session ─────────────────────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ─── Google Drive OAuth ──────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Application type: Web application
# Authorized redirect URI must match GOOGLE_REDIRECT_URI below, exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/providers/google/callback

# ─── Email (key delivery + admin alerts) ─────────────────────────────────────
# Gmail: enable 2-Step Verification, then create an App Password at
# myaccount.google.com/apppasswords — use that, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hybrid Cloud Encryption <no-reply@localhost>"

# Alerts (failed key attempts, pending approvals) are sent here.
ADMIN_EMAIL=

# ─── WebAuthn / passkeys ─────────────────────────────────────────────────────
# RP_ID is the bare domain — no scheme, no port. RP_ORIGIN must match the
# browser's origin exactly, port included.
RP_ID=localhost
RP_NAME=Hybrid Cloud Encryption
RP_ORIGIN=http://localhost:5173
